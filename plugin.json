{
  "manifest_version": 2,
  "id": "anka-outpost-strike",
  "name": "ANKA 前线对决",
  "version": "1.6.0",
  "icon": "crosshair",
  "description": "创建房间邀请好友，选择合作或对战模式，支持断线重连和手机、ESP-Mosaico 手柄。",
  "kind": "app",
  "system": false,
  "backend": {
    "entry": "server/main.py"
  },
  "ui": {
    "entry": "web/index.js",
    "route": "/anka-outpost-strike",
    "dock": {
      "order": 40
    }
  },
  "build": {
    "requires": [
      "node>=22.12.0"
    ],
    "steps": [
      {
        "run": "npm ci --prefer-offline --no-audit --no-fund"
      },
      {
        "run": "npm run build"
      }
    ],
    "output": {
      "entry": "dist/index.html"
    },
    "timeout": 600
  },
  "permissions": [
    "net"
  ]
}
